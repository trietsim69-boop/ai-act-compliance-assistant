# Copy to .env (never commit it). Shell variables override this file.
DEEPSEEK_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-chat
# Any OpenAI-compatible endpoint; defaults to https://api.deepseek.com
LLM_BASE_URL=

# Optional: require this code in the x-access-code header (leave empty for local dev)
ACCESS_CODE=
